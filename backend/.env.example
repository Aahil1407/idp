DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smartsplit
DB_SSL=false
# Optional: path to the database provider's CA certificate when DB_SSL=true
# DB_SSL_CA_PATH=C:/path/to/provider-ca.pem

# Comma-separated exact frontend origins allowed to send credentialed requests.
# FRONTEND_ORIGINS=https://app.example.com
# Set COOKIE_SAME_SITE=None only for a cross-site HTTPS frontend/API deployment.
# COOKIE_SAME_SITE=Lax
# Set TRUST_PROXY=1 only when the service is behind exactly one trusted proxy.
# TRUST_PROXY=1
